<mxfile host="app.diagrams.net">
  <diagram id="it-landscape" name="IT Landscape">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Карта текущего IT-ландшафта банка &quot;Стандарт&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;width:100%;table-layout:fixed;font-size:11px;'&gt;&lt;tr style='background:#d5e8d4;font-weight:bold;'&gt;&lt;th&gt;Орг. единица&lt;/th&gt;&lt;th&gt;Отделения&lt;/th&gt;&lt;th&gt;Кол-центр&lt;/th&gt;&lt;th&gt;Сайт&lt;/th&gt;&lt;th&gt;Интернет-банк&lt;/th&gt;&lt;th&gt;Депозиты&lt;/th&gt;&lt;th&gt;Кредиты&lt;/th&gt;&lt;th&gt;Скоринг&lt;/th&gt;&lt;th&gt;Уведомления&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Сеть отделений&lt;/td&gt;&lt;td&gt;АБС, почта&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Открытие депозитов и печать документов&lt;/td&gt;&lt;td&gt;Заведение заявки на кредит в АБС&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Бумажные документы клиенту&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;IT: интернет-банк и сайт&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Сайт PHP + React&lt;/td&gt;&lt;td&gt;Интернет-банк ASP.NET MVC 4.5&lt;/td&gt;&lt;td&gt;Публикация условий без оформления&lt;/td&gt;&lt;td&gt;Онлайн-кредитов пока нет&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;IT: АБС&lt;/td&gt;&lt;td&gt;Delphi-клиент + Oracle&lt;/td&gt;&lt;td&gt;Приём обращений из КЦ&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Интеграция с ИБ по БД&lt;/td&gt;&lt;td&gt;Учёт депозитов, загрузка документов&lt;/td&gt;&lt;td&gt;Учёт кредитных заявок и выдача средств&lt;/td&gt;&lt;td&gt;Выгрузки данных для скоринга&lt;/td&gt;&lt;td&gt;SMS через шлюз&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Управление депозитных продуктов&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Обработка заявок из КЦ в АБС&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Excel-ставки и согласование по почте&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Управление кредитных продуктов&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Согласование спецставок для обеспеченных клиентов&lt;/td&gt;&lt;td&gt;Кредитный конвейер и принятие решения&lt;/td&gt;&lt;td&gt;Система скоринга и БКИ&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Кол-центр банка&lt;/td&gt;&lt;td&gt;Консультация перед визитом&lt;/td&gt;&lt;td&gt;Система кол-центра подрядчика&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Создание обращений по депозитам&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Информирование по скрипту&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Партнёрский кол-центр&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Внешняя система, в текущем процессе не участвует&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Команда цифровой трансформации&lt;/td&gt;&lt;td&gt;Анализ и трансформация процессов&lt;/td&gt;&lt;td&gt;Анализ и трансформация процессов&lt;/td&gt;&lt;td&gt;Развитие цифровых каналов&lt;/td&gt;&lt;td&gt;Развитие цифровых каналов&lt;/td&gt;&lt;td&gt;Проект цифровизации депозитов&lt;/td&gt;&lt;td&gt;Проект цифровизации кредитов&lt;/td&gt;&lt;td&gt;Формирование требований к целевой архитектуре&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="1720" height="440" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Пояснения&#xa;1. В строках отражены ключевые организационные единицы и участники текущего ландшафта.&#xa;2. В колонках показаны business capabilities второго уровня, которые задействованы в депозитном и кредитном процессе.&#xa;3. Основные проблемы текущего состояния: Excel и email в расчёте ставок, прямая интеграция интернет-банка с АБС по БД, суточный обмен между АБС и кредитным конвейером." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="920" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
